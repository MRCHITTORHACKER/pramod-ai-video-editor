{
  "id": "t01_viral_hook_intro",
  "name": "Viral Hook Intro",
  "category": "viral",
  "description": "Short videos with a strong opening: big bold title scales in over visible footage.",
  "thumbnailRef": "thumb_t01_viral_hook_intro.png",
  "aspectRatios": [
    "R_9_16"
  ],
  "minDurationSec": 5,
  "maxDurationSec": 30,
  "captionLayout": {
    "position": "center",
    "maxWordsPerCaption": 5,
    "safeMarginPercent": 10.0,
    "backgroundStyle": "none",
    "backgroundOpacity": 0.0
  },
  "typography": {
    "fontFamily": "sans_serif_black",
    "devanagariSupport": true,
    "baseSizeSp": 56,
    "textColor": "#FFFFFF",
    "accentColor": "#FFD54F",
    "strokeColor": "#000000",
    "strokeWidthDp": 3.0
  },
  "textAnimations": [
    {
      "type": "scale_in",
      "startScale": 0.88,
      "endScale": 1.0,
      "fadeInMs": 200,
      "easing": "ease_out",
      "overshoot": true
    }
  ],
  "transitions": [
    {
      "type": "cut",
      "durationMs": 0
    }
  ],
  "vfx": [
    {
      "effectId": "dim_background",
      "placement": "intro",
      "intensity": 0.35,
      "params": {
        "opacity": 0.35
      }
    }
  ],
  "emojiRules": {
    "category": "none",
    "animation": "pop",
    "maxPerVideo": 3,
    "autoSuggest": false
  },
  "sfxRules": [
    {
      "onEvent": "title_entry",
      "category": "whoosh",
      "gainDb": -6.0,
      "enabled": true,
      "maxOccurrences": 3
    },
    {
      "onEvent": "major_title",
      "category": "impact",
      "gainDb": -4.0,
      "enabled": true,
      "maxOccurrences": 1
    }
  ],
  "musicBehavior": {
    "mood": "none",
    "duckUnderSpeech": true,
    "duckLevelDb": -10.0,
    "fadeInMs": 800,
    "fadeOutMs": 1200
  },
  "timingRules": {
    "syncSource": "speech",
    "requireRealBeatAnalysis": true,
    "minTextOnScreenMs": 1200,
    "maxTextOnScreenMs": 2500
  },
  "effectIntensity": 0.6,
  "previewNotes": "Title 0-1.2s over real video frames; keep faces uncovered.",
  "exportNotes": "Respect selected aspect ratio; preserve source audio unless disabled.",
  "deviceRequirements": "minSdk 26; low-effects mode auto-enabled on low-RAM devices",
  "assetLicense": "Original configuration; no third-party assets bundled.",
  "version": "1.0.0",
  "testCases": [
    "Title enters 0-1.2s with scale 0.88->1.0 ease-out",
    "Exactly one whoosh + max one impact placed",
    "Faces/important content not covered by title safe-area check"
  ]
}