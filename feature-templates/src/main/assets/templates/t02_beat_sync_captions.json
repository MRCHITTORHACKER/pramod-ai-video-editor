{
  "id": "t02_beat_sync_captions",
  "name": "Beat Sync Captions",
  "category": "viral",
  "description": "Energetic talking videos: word-level captions with pop animation, beat-synced only on real analysis.",
  "thumbnailRef": "thumb_t02_beat_sync_captions.png",
  "aspectRatios": [
    "R_9_16"
  ],
  "minDurationSec": 5,
  "maxDurationSec": 60,
  "captionLayout": {
    "position": "bottom_center",
    "maxWordsPerCaption": 6,
    "safeMarginPercent": 8.0,
    "backgroundStyle": "none",
    "backgroundOpacity": 0.0
  },
  "typography": {
    "fontFamily": "sans_serif_bold",
    "devanagariSupport": true,
    "baseSizeSp": 44,
    "textColor": "#FFFFFF",
    "accentColor": "#00E5FF",
    "strokeColor": "#000000",
    "strokeWidthDp": 2.0
  },
  "textAnimations": [
    {
      "type": "pop",
      "startScale": 0.9,
      "endScale": 1.0,
      "fadeInMs": 120,
      "easing": "ease_out",
      "overshoot": false
    }
  ],
  "transitions": [
    {
      "type": "cut",
      "durationMs": 0
    }
  ],
  "vfx": [],
  "emojiRules": {
    "category": "none",
    "animation": "pop",
    "maxPerVideo": 3,
    "autoSuggest": false
  },
  "sfxRules": [
    {
      "onEvent": "word_emphasis",
      "category": "pop",
      "gainDb": -12.0,
      "enabled": true,
      "maxOccurrences": 8
    }
  ],
  "musicBehavior": {
    "mood": "energetic",
    "duckUnderSpeech": true,
    "duckLevelDb": -10.0,
    "fadeInMs": 600,
    "fadeOutMs": 1000
  },
  "timingRules": {
    "syncSource": "fixed_beats",
    "requireRealBeatAnalysis": true,
    "minTextOnScreenMs": 800,
    "maxTextOnScreenMs": 3000
  },
  "effectIntensity": 0.55,
  "previewNotes": "If no beat analysis exists, engine falls back to manual markers / sentence timing.",
  "exportNotes": "Word timestamps must come from real transcription; never invent timings.",
  "deviceRequirements": "minSdk 26; low-effects mode auto-enabled on low-RAM devices",
  "assetLicense": "Original configuration; no third-party assets bundled.",
  "version": "1.0.0",
  "testCases": [
    "Word timestamps drive caption changes",
    "No beat grid -> falls back to manual markers with warning",
    "Captions stay inside safe margins"
  ]
}