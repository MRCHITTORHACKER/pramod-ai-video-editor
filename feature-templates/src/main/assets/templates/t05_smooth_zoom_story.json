{
  "id": "t05_smooth_zoom_story",
  "name": "Smooth Zoom Story",
  "category": "viral",
  "description": "Emphasize moments with smooth interpolated zoom; no sudden jumps.",
  "thumbnailRef": "thumb_t05_smooth_zoom_story.png",
  "aspectRatios": [
    "R_9_16"
  ],
  "minDurationSec": 5,
  "maxDurationSec": 60,
  "captionLayout": {
    "position": "bottom_center",
    "maxWordsPerCaption": 6,
    "safeMarginPercent": 8.0,
    "backgroundStyle": "none",
    "backgroundOpacity": 0.0
  },
  "typography": {
    "fontFamily": "sans_serif_bold",
    "devanagariSupport": true,
    "baseSizeSp": 42,
    "textColor": "#FFFFFF",
    "accentColor": "#7C4DFF",
    "strokeColor": "#000000",
    "strokeWidthDp": 2.0
  },
  "textAnimations": [
    {
      "type": "fade_in",
      "startScale": 1.0,
      "endScale": 1.0,
      "fadeInMs": 250,
      "easing": "ease_out",
      "overshoot": false
    }
  ],
  "transitions": [
    {
      "type": "zoom_blur",
      "durationMs": 350
    }
  ],
  "vfx": [
    {
      "effectId": "smooth_zoom",
      "placement": "emphasis",
      "intensity": 0.6,
      "params": {
        "zoomFrom": 1.0,
        "zoomTo": 1.25
      }
    }
  ],
  "emojiRules": {
    "category": "none",
    "animation": "pop",
    "maxPerVideo": 3,
    "autoSuggest": false
  },
  "sfxRules": [
    {
      "onEvent": "zoom_start",
      "category": "whoosh",
      "gainDb": -10.0,
      "enabled": true,
      "maxOccurrences": 4
    }
  ],
  "musicBehavior": {
    "mood": "none",
    "duckUnderSpeech": true,
    "duckLevelDb": -10.0,
    "fadeInMs": 800,
    "fadeOutMs": 1200
  },
  "timingRules": {
    "syncSource": "speech",
    "requireRealBeatAnalysis": true,
    "minTextOnScreenMs": 1200,
    "maxTextOnScreenMs": 4000
  },
  "effectIntensity": 0.6,
  "previewNotes": "Zoom keeps subject inside frame; configurable 1.0x-1.5x range.",
  "exportNotes": "Interpolate zoom smoothly across the effect duration.",
  "deviceRequirements": "minSdk 26; low-effects mode auto-enabled on low-RAM devices",
  "assetLicense": "Original configuration; no third-party assets bundled.",
  "version": "1.0.0",
  "testCases": [
    "Zoom interpolates without jumps",
    "Subject stays in frame (center-weighted)",
    "No impact SFX on every zoom"
  ]
