{
  "id": "t06_education_explainer",
  "name": "Education Explainer",
  "category": "education",
  "description": "Lessons & exam prep: clean high-contrast captions, key-term highlights, fact cards.",
  "thumbnailRef": "thumb_t06_education_explainer.png",
  "aspectRatios": [
    "R_9_16",
    "R_16_9",
    "R_1_1"
  ],
  "minDurationSec": 15,
  "maxDurationSec": 300,
  "captionLayout": {
    "position": "bottom_center",
    "maxWordsPerCaption": 10,
    "safeMarginPercent": 8.0,
    "backgroundStyle": "box",
    "backgroundOpacity": 0.7
  },
  "typography": {
    "fontFamily": "sans_serif",
    "devanagariSupport": true,
    "baseSizeSp": 40,
    "textColor": "#FFFFFF",
    "accentColor": "#80DEEA",
    "strokeColor": "#000000",
    "strokeWidthDp": 1.5
  },
  "textAnimations": [
    {
      "type": "fade_in",
      "startScale": 1.0,
      "endScale": 1.0,
      "fadeInMs": 200,
      "easing": "ease_out",
      "overshoot": false
    }
  ],
  "transitions": [
    {
      "type": "fade",
      "durationMs": 250
    }
  ],
  "vfx": [],
  "emojiRules": {
    "category": "none",
    "animation": "pop",
    "maxPerVideo": 3,
    "autoSuggest": false
  },
  "sfxRules": [
    {
      "onEvent": "transition",
      "category": "educational_cue",
      "gainDb": -14.0,
      "enabled": true,
      "maxOccurrences": 6
    }
  ],
  "musicBehavior": {
    "mood": "none",
    "duckUnderSpeech": true,
    "duckLevelDb": -10.0,
    "fadeInMs": 800,
    "fadeOutMs": 1200
  },
  "timingRules": {
    "syncSource": "sentence",
    "requireRealBeatAnalysis": true,
    "minTextOnScreenMs": 2000,
    "maxTextOnScreenMs": 6000
  },
  "effectIntensity": 0.25,
  "previewNotes": "Numbered fact cards + optional Q/A layout; Hindi + English.",
  "exportNotes": "Text stays long enough to read; minimal VFX.",
  "deviceRequirements": "minSdk 26; low-effects mode auto-enabled on low-RAM devices",
  "assetLicense": "Original configuration; no third-party assets bundled.",
  "version": "1.0.0",
  "testCases": [
    "Key terms highlighted, definitions readable",
    "Hindi + English render correctly",
    "No loud effects by default"
  ]
}