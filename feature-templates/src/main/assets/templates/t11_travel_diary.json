{
  "id": "t11_travel_diary",
  "name": "Travel Diary",
  "category": "vlog",
  "description": "Travel/scenic: smooth cross-clip transitions, warm/cool presets, user location labels.",
  "thumbnailRef": "thumb_t11_travel_diary.png",
  "aspectRatios": [
    "R_9_16",
    "R_16_9",
    "R_1_1"
  ],
  "minDurationSec": 15,
  "maxDurationSec": 300,
  "captionLayout": {
    "position": "bottom_center",
    "maxWordsPerCaption": 8,
    "safeMarginPercent": 10.0,
    "backgroundStyle": "none",
    "backgroundOpacity": 0.0
  },
  "typography": {
    "fontFamily": "serif",
    "devanagariSupport": true,
    "baseSizeSp": 40,
    "textColor": "#FFF8E1",
    "accentColor": "#FFCC80",
    "strokeColor": "#000000",
    "strokeWidthDp": 1.5
  },
  "textAnimations": [
    {
      "type": "fade_in",
      "startScale": 1.0,
      "endScale": 1.0,
      "fadeInMs": 500,
      "easing": "ease_in_out",
      "overshoot": false
    }
  ],
  "transitions": [
    {
      "type": "fade",
      "durationMs": 500
    }
  ],
  "vfx": [
    {
      "effectId": "color_grade",
      "placement": "throughout",
      "intensity": 0.4,
      "params": {
        "warmth": 0.65,
        "contrast": 1.05
      }
    }
  ],
  "emojiRules": {
    "category": "none",
    "animation": "pop",
    "maxPerVideo": 3,
    "autoSuggest": false
  },
  "sfxRules": [
    {
      "onEvent": "transition",
      "category": "soft_transition",
      "gainDb": -12.0,
      "enabled": true,
      "maxOccurrences": 8
    },
    {
      "onEvent": "scene",
      "category": "ambient_atmosphere",
      "gainDb": -16.0,
      "enabled": true,
      "maxOccurrences": 3
    }
  ],
  "musicBehavior": {
    "mood": "ambient",
    "duckUnderSpeech": false,
    "duckLevelDb": -6.0,
    "fadeInMs": 1200,
    "fadeOutMs": 1500
  },
  "timingRules": {
    "syncSource": "speech",
    "requireRealBeatAnalysis": true,
    "minTextOnScreenMs": 1200,
    "maxTextOnScreenMs": 4000
  },
  "effectIntensity": 0.4,
  "previewNotes": "Location labels are user-supplied; never fabricate places/dates.",
  "exportNotes": "Music may span multiple clips.",
  "deviceRequirements": "minSdk 26; low-effects mode auto-enabled on low-RAM devices",
  "assetLicense": "Original configuration; no third-party assets bundled.",
  "version": "1.0.0",
  "testCases": [
    "No fabricated locations/dates",
    "Transitions smooth between clips",
    "Music spans clips without gaps"
  ]
}